# Core Django settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Set DB_ENGINE=postgresql in production. SQLite is for local development/tests.
DB_ENGINE=sqlite
DB_NAME=nasarawa_chatbot
DB_USER=nasarawa_chatbot
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# HTTPS/security (enable behind a correctly configured TLS reverse proxy)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False
DJANGO_HSTS_SECONDS=0

# Verified enquiry channel. Leave blank until officially confirmed for deployment.
OFFICIAL_ENQUIRY_EMAIL=info@nasarawastate.gov.ng
OFFICIAL_ENQUIRY_URL=https://nasarawastate.gov.ng/contacts

# Privacy and matching
CHAT_DATA_RETENTION_DAYS=90
CHAT_MATCH_THRESHOLD=62
CHAT_SUGGESTION_THRESHOLD=35
CHAT_RATE=30/minute
FAQ_SEARCH_RATE=60/minute

# Optional application logging
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FILE=

# Optional shared cache/rate-limit backend and error monitoring
CACHE_BACKEND=local
REDIS_URL=redis://127.0.0.1:6379/1
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
